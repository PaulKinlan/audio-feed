#!/usr/bin/env bash
# audio-feed-ng60: prevent publishing a non-gated tree or accidentally pushing main onto a feature branch.
set -eo pipefail

remote="${1:-origin}"
url="${2:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletion
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  [ -z "$local_sha" ] && continue

  # Guard 1: Prevent accidentally pushing origin/main onto a fleet/* feature branch (audio-feed-ng60)
  if [[ "$remote_ref" =~ ^refs/heads/fleet/ ]]; then
    main_sha=$(git rev-parse origin/main 2>/dev/null || echo "")
    if [ -n "$main_sha" ] && [ "$local_sha" = "$main_sha" ]; then
      echo "pre-push: REFUSING to push $remote_ref - local commit $local_sha equals origin/main." >&2
      echo "Publishing a copy of main onto a feature branch is forbidden (audio-feed-ng60)." >&2
      exit 1
    fi
  fi

  # Guard 2: Prevent pushing a non-gated tree when FLEET_REQUIRE_GATED_PUSH=1
  # (or when running under fleet lane environment)
  if [ "${FLEET_REQUIRE_GATED_PUSH:-0}" = "1" ]; then
    tree=$(git rev-parse "${local_sha}^{tree}" 2>/dev/null || echo "")
    if [ -n "$tree" ]; then
      has_pass=0
      for rec in "$HOME/.fleet/checks/$tree.fast.json" "$HOME/.fleet/checks/$tree.json"; do
        if [ -f "$rec" ] && [ "$(jq -r .state "$rec" 2>/dev/null)" = "PASS" ]; then
          has_pass=1
          break
        fi
      done
      if [ "$has_pass" -eq 0 ]; then
        echo "pre-push: REFUSING push of $remote_ref ($local_sha) - tree $tree has no passing fleet-check record." >&2
        echo "Run fleet-check --fast before pushing (audio-feed-ng60)." >&2
        exit 1
      fi
    fi
  fi
done

exit 0

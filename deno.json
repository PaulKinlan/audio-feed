{
  "name": "@paulkinlan/audio-feed",
  "version": "0.1.0",
  "exports": "./src/server.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write --unstable-kv src/server.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv src/server.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write --unstable-kv",
    "check": "deno check main.ts src/**/*.ts tests/**/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "smoke": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv scripts/smoke.ts",
    "gate": "deno fmt --check && deno lint && deno check main.ts src/**/*.ts tests/**/*.ts && deno test --allow-net --allow-env --allow-read --allow-write --unstable-kv"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "aws4fetch": "npm:aws4fetch@^1.0.20"
  },
  "unstable": ["kv"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  // TypeScript source only. Markdown and generated config (.claude/, .agents/,
  // .codex/) are tool-authored -- `bd setup` rewrites them -- so formatting
  // those files means a reformat-vs-regenerate fight on every bd upgrade.
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "include": ["src/", "tests/", "main.ts"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [".beads/", "var/"]
}

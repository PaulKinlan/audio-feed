{
  "name": "@paulkinlan/audio-feed",
  "version": "0.1.0",
  "exports": "./src/server.ts",
  // audio-feed-w55i: pin the Deno Deploy runtime entrypoint IN THE REPO. The live project failed a
  // build with "Entrypoint at /tmp/build/src/src/server.ts not found" (src/ applied twice) because
  // the entrypoint lived only in the dashboard, where nobody could see it drift. Deno Deploy reads
  // this block from deno.json and, once a build succeeds from source configuration, the
  // corresponding dashboard fields become code-managed. main.ts is the root deno-serve entrypoint
  // Paul added in bc47dd4; it re-exports src/server.ts's default fetch handler.
  "deploy": {
    "runtime": {
      "type": "dynamic",
      "entrypoint": "main.ts"
    }
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write --unstable-kv src/server.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv src/server.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write --allow-run --unstable-kv",
    "test:cron": "deno test --unstable-cron --allow-net --allow-env --allow-read --allow-write --unstable-kv tests/cron_test.ts",
    "check": "deno check main.ts src tests scripts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "smoke": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv scripts/smoke.ts",
    "evidence:compress": "deno run --allow-read --allow-write --allow-run=convert,git scripts/evidence-compress.ts",
    // audio-feed-h22ml: the tier WRITES its own records now (docs/evidence/<id>/run.json) and reads
    // git history for staleness (rev-parse / merge-base --is-ancestor), hence --allow-write and git.
    "evidence": "deno run --allow-read --allow-write --allow-run=deno,timeout,git --allow-env scripts/evidence-run.ts",
    "evidence:mutants": "deno run --allow-read --allow-write --allow-run=timeout,deno --allow-env scripts/exww-mutants.ts",
    "proof": "deno run --allow-all --unstable-kv",
    // audio-feed-p2la: the pre-push guard (scripts/hooks/pre-push) refuses an ungated push and a
    // copy of main onto a fleet/* branch, and a guard that is not INSTALLED silently protects
    // nothing — the installation used to be a best-effort call inside scripts/fast-check.ts, gated
    // on a permission test:fast never grants, with its child's exit status discarded. Both gates now
    // ARM it (`hooks:install`) and then VERIFY it where git will actually look (`hooks:verify`), as
    // their FIRST two steps; scripts/fast-check.ts asserts the same thing in-process (exit 1, by
    // name, otherwise) so a deleted wiring step still reddens the fast path. Both steps run in the
    // shell, so no Deno permission list is widened for the installer, and hooks:verify runs with
    // FEWER permissions than the gate that hosts it. They fail CLOSED: a clone they cannot arm does
    // not gate green.
    "hooks:install": "bash scripts/hooks/install-hooks.sh",
    "hooks:verify": "deno run --allow-read --allow-run=git scripts/hooks/guard-status.ts",
    "test:fast": "deno task hooks:install && deno task hooks:verify && deno run --allow-read --allow-run=git,deno --allow-env scripts/fast-check.ts",
    "inventory": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv scripts/legacy-audio-inventory.ts",
    "migrate-legacy-audio": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv scripts/migrate-legacy-audio.ts",
    "migrate:audio-keys": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv scripts/migrate-legacy-audio.ts",
    // audio-feed-pnw73: `deno test --no-check` is deliberate and sound ONLY here, because the
    // `deno check main.ts src tests scripts` immediately to its left type-checks the same tree over
    // the same roots first. Doing it twice cost ~5-7% of the whole gate (measured: 201.4s/259.8s
    // with the duplicate, 191.6s/187.5s without, same 2267 tests, same result). The bare `test`
    // task below must NOT take the flag: it runs no check first, so it is the only type check there.
    "gate": "deno task hooks:install && deno task hooks:verify && deno run --allow-read --allow-write --allow-env --allow-run=deno scripts/test-selection.ts --prove-discovery && deno fmt --check && deno lint && deno check main.ts src tests scripts && deno test --allow-net --allow-env --allow-read --allow-write --allow-run --unstable-kv --no-check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "aws4fetch": "npm:aws4fetch@^1.0.20",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@14.0.3"
  },
  "unstable": ["kv"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  // TypeScript source only. Markdown and generated config (.claude/, .agents/,
  // .codex/) are tool-authored -- `bd setup` rewrites them -- so formatting
  // those files means a reformat-vs-regenerate fight on every bd upgrade.
  // scripts/ IS hand-written TypeScript, and the gate already type-checks it, so it is in scope
  // too (audio-feed-7jsl): while it was absent, `deno fmt --check` passed over 205 files with 17
  // unformatted files under scripts/ unexamined -- a green gate reporting a property it had not
  // checked. Two things that follow from this list: `deno fmt <path>` on anything OUTSIDE it
  // reformats files the project deliberately leaves alone, so name files, never directories, when
  // formatting by hand; and the include list is the only place to add a tree, because the gate,
  // editors and CI all run bare `deno fmt --check`.
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "include": ["src/", "tests/", "main.ts", "scripts/"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [".beads/", "var/"]
}

{
  "name": "@paulkinlan/audio-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build:assets": "node scripts/generate-assets.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "d1:migrate:local": "CI=1 wrangler d1 migrations apply audio-feed --local",
    "d1:migrate:remote": "CI=1 wrangler d1 migrations apply audio-feed --remote",
    "import:d1:local": "tsx scripts/import-d1.ts --local",
    "import:d1:remote": "tsx scripts/import-d1.ts --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:d1": "vitest run tests/d1_storage_test.ts tests/r2_blob_test.ts tests/worker_entry_test.ts",
    "gate": "npm run build:assets && npm run typecheck && npm run deploy:dry-run && npm test"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@simplewebauthn/server": "14.0.3",
    "aws4fetch": "^1.0.20",
    "ipaddr.js": "2.2.0",
    "linkedom": "0.18.12",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260401.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wrangler": "^4.14.0"
  }
}
